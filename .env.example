# Data source selector: mock | supabase
VITE_DATA_SOURCE=supabase

# Store contact details (safe to expose to the client)
VITE_WHATSAPP_NUMBER=
VITE_STORE_EMAIL=

# Supabase (public anon key — safe to expose, RLS-gated)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics (added post-launch)
VITE_GA_MEASUREMENT_ID=

# NOTE: any Supabase service-role key is server-side only. It must NEVER be
# prefixed VITE_ or placed in this file — Vite exposes every VITE_-prefixed
# variable to the client bundle.
